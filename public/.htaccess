# ─────────────────────────────────────────────────────────────
#  GTA-Tech — SPA (Vite + TanStack Router) — Apache / Hostinger
#  Este ficheiro é copiado de public/.htaccess para dist/.htaccess
#  pelo Vite em cada build (npm run build).
# ─────────────────────────────────────────────────────────────

Options -Indexes
ServerSignature Off

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Base do projeto (ajuste se a app não estiver na raiz do domínio)
    RewriteBase /

    # Se o ficheiro/diretório existir, serve-o diretamente (imagens, css, js…)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todas as rotas do SPA (/login, /admin, /admin/services, …) → index.html
    RewriteRule ^ index.html [L]
</IfModule>

# ── Cache de ativos gerados pelo Vite (content-hashed, imutáveis)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── Compressão
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cabeçalhos de segurança básicos
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
